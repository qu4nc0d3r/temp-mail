{
  "name": "temp-mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:frontend && wrangler dev",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "deploy": "npm run build:frontend && wrangler deploy",
    "test": "npm run test:worker && npm run test:frontend",
    "test:worker": "vitest run",
    "test:frontend": "vitest run --config vitest.frontend.config.ts"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "hono": "^4.6.0",
    "postal-mime": "^2.3.0",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "^5.20260820.0",
    "@mdi/js": "^7.4.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "latest",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0",
    "wrangler": "latest"
  }
}
